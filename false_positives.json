    "rules": {
      "enable_number_check": true,
      "enable_single_word_filter": true,
      "enable_address_check": true,
      "enable_job_title_check": true,
      "enable_date_check": true,
      "enable_capitalization_check": true,
      "enable_repeated_word_filter": true,
      "enable_max_word_count_filter": true,
      "enable_honorific_only_filter": true,
      "min_name_length": 3,
      "max_name_word_count": 5,
      "min_name_word_count": 2,
      "context_window_size": 30,
      "max_single_word_penalty": 0.5
    }
