  "_comments": {
    "how_to_add_words":     "Add words to any existing category's 'words' array, or create a brand-new category block — the loader picks it up automatically.",
    "how_to_add_category":  "Copy any existing category block, give it a new key, fill in 'words', set 'roles' to [] unless it needs special rule behaviour.",
    "roles_explained": {
      "date_first_word":   "Words in this category trigger date suppression when they appear as the first token followed by a number (e.g. 'January 15').",
      "address_last_word": "Words in this category trigger address suppression when they appear as the last token of a match (e.g. 'Oak Street').",
      "job_title_word":    "Words in this category trigger job-title suppression unless a formal honorific is present in the surrounding context."
    },
    "rules_explained": {
      "enable_repeated_word_filter":   "Suppresses matches where the same word appears twice, e.g. 'North North' or 'East East'.",
      "enable_max_word_count_filter":  "Suppresses matches longer than max_name_word_count words.",
      "enable_honorific_only_filter":  "Suppresses matches that consist entirely of honorific words (e.g. a standalone 'Mr' or 'Dr').",
      "context_window_size":           "Characters to look behind the match when checking negative context keywords.",
      "min_name_word_count":           "Matches with fewer words than this are treated as single-word matches and checked against the false-positive word list."
    },
    "restart_required": "Restart the application after modifying this file, or call reload_rules() programmatically for a hot reload."
  }
